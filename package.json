{
  "name": "blockquest-academy",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "BlockQuest: Crystal Island — игра и первый урок программирования",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
